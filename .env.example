# Kopjojeni në .env dhe plotësoni vlerat. MOS e ruani .env në git.
DOMAIN=pos.globi.al
LETSENCRYPT_EMAIL=

# Gjeneroni secilën me: openssl rand -base64 48 | tr -d '/+='
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# disabled | mock | test | production  (test/production kërkojnë certifikatën fiskale, shih docs/FISKALIZIMI.md)
FISCAL_MODE=mock

# Backup jashtë serverit (object storage S3-compatible, në një provider/rajon tjetër nga serveri)
S3_ENDPOINT=
S3_BUCKET=globi-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
BACKUP_ENCRYPTION_PASSPHRASE=
BACKUP_CRON=15 3 * * *
BACKUP_RETENTION_DAYS=30
# Opsionale: URL "ping" (healthchecks.io / Uptime Kuma) që ju njofton kur backup-i nuk ndodh
BACKUP_HEALTHCHECK_URL=

GRAFANA_PASSWORD=
