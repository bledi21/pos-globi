# Gjenerohet nga imazhi nginx me envsubst (vetëm ${DOMAIN} zëvendësohet).
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=conn:10m;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

upstream globi_api {
  server api:3000;
  keepalive 32;
}

server {
  listen 80;
  server_name ${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy same-origin always;

  server_tokens off;
  client_max_body_size 5m;
  limit_conn conn 50;

  # Metrikat janë vetëm për rrjetin e brendshëm
  location = /metrics { return 404; }

  location /api/v1/auth/ {
    limit_req zone=auth burst=10 nodelay;
    proxy_pass http://globi_api;
    include /etc/nginx/templates/proxy_params.inc;
  }

  location = /api/v1/ws {
    proxy_pass http://globi_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 1h;
  }

  location /api/ {
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://globi_api;
    include /etc/nginx/templates/proxy_params.inc;
  }

  location = /health { proxy_pass http://globi_api; }
  location = /ready  { proxy_pass http://globi_api; }

  # Grafana (profili monitoring) — vetëm nëse e keni ndezur
  location /grafana/ {
    resolver 127.0.0.11 valid=30s;
    set $grafana_upstream http://grafana:3000;
    proxy_pass $grafana_upstream;
    proxy_set_header Host $host;
  }

  # Paneli i pronarit (faqe statike, punon edhe në telefon)
  location / {
    root /usr/share/nginx/owner;
    try_files $uri $uri/ /index.html;
  }
}
